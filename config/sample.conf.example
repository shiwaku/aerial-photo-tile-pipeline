# 航空写真タイル生成パイプラインの設定サンプル
#
# 使い方:
#   cp config/sample.conf.example config/sample.conf
#   （値を編集してから）
#   ./scripts/run_pipeline.sh config/sample.conf

# --- 識別子 -------------------------------------------------------------------

# 出力先ディレクトリ名になる（output/<DATASET_ID>/）
DATASET_ID="sample"

# TileJSON の name に入る表示名
DATASET_NAME="航空写真サンプル"

# --- 入力 ---------------------------------------------------------------------

# 画像とワールドファイルを同一ディレクトリに平置きする
SRC_DIR="data/sample"

# 入力画像の拡張子。auto なら tif/tiff/jpg/jpeg/png を拾い、混在も受け付ける
SRC_EXT="auto"

# 入力の CRS。
#   auto            … 画像に CRS があればそれを使い、無ければ図郭コード先頭2桁の
#                     系番号を座標値で検証して判定する（判定できなければエラー）
#   EPSG:xxxx       … 明示指定。auto の判定結果と違う場合はこちらを優先
# JGD2011 平面直角座標系: 第1系=EPSG:6669 … 第19系=EPSG:6687（系番号 + 6668）
# 経緯度のオープンデータなら EPSG:4326、Web メルカトルなら EPSG:3857
SRC_SRS="auto"

# 図郭外（撮影範囲外）の余白色。この色をアルファバンドに変換して透過させる。
#   auto            … 外周画素を実測し、単色で埋まっていればその色を採用。
#                     余白が無ければ透過処理をしない
#   "255 255 255"   … 白地を透過
#   "0 0 0"         … 黒地を透過
#   ""（空）        … 透過処理をしない
# 余白が無いデータに値を指定すると、影（純黒）や白飽和部分を誤透過させるため注意
NODATA="auto"

# --- ズームレベル -------------------------------------------------------------

MIN_ZOOM="9"

# auto = GSD から自動決定（タイル解像度が GSD に最も近い ZL）
# 数値を書けばその値を使う
MAX_ZOOM="auto"

# --- 出力形式 -----------------------------------------------------------------

# タイルの出力形態。
#   dir      … XYZ ディレクトリ。静的ホスティングにそのまま置ける
#   pmtiles  … 単一ファイル。小さいファイルが大量にできないので配布・保管が楽
TILE_OUTPUT="dir"

# --- 以下は TILE_OUTPUT="pmtiles" のときだけ効く -------------------------------

# PMTiles の作り方。どちらも最後は MBTiles を経由する
# （pmtiles convert の入力は MBTiles のみのため）。
#   gdal2tiles   … gdal2tiles → mb-util → pmtiles convert（既定・実測で2.7倍速い）
#                  中間の XYZ ディレクトリを一度作る。要 mb-util
#   rio-mbtiles  … rio mbtiles → pmtiles convert
#                  中間ディレクトリを作らないが遅い。要 rio-mbtiles
PMTILES_VIA="gdal2tiles"

# 変換後に中間の MBTiles を残すか（本番規模では数GBになる）
PMTILES_KEEP_MBTILES="true"

# 変換後に中間の XYZ ディレクトリを残すか（PMTILES_VIA="gdal2tiles" のときのみ）
# 本番規模では数十万ファイルになる。削除にも時間がかかる点に注意
PMTILES_KEEP_TILES="true"

# webp（推奨・写真系で圧縮がよく効く）または png
TILE_FORMAT="webp"

# 非可逆の品質（1-100）。可逆にする場合は lossless と書く
WEBP_QUALITY="85"

# 縮小時の再標本化方法（average / near / bilinear / lanczos など）
RESAMPLING="average"

# --- 配信メタデータ -----------------------------------------------------------

# 出典表記（オープンデータのライセンス表記をここに入れる）
ATTRIBUTION=""

# 本番のタイル URL テンプレート。空ならローカルプレビュー用の相対パスになる
TILE_URL_TEMPLATE=""

# --- 実行環境 -----------------------------------------------------------------

# 並列数。空なら nproc
JOBS=""

# gdalbuildvrt への追加オプション（例: "-addalpha" / "-resolution highest"）
VRT_EXTRA_OPTS=""
