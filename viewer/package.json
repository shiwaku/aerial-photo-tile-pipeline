{
  "name": "aerial-photo-tile-viewer",
  "version": "1.0.0",
  "private": true,
  "description": "航空写真オルソ画像タイル（XYZ / PMTiles）を表示するWebビューワ",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:pages": "tsc --noEmit && vite build --mode pages",
    "preview": "vite preview",
    "deploy": "npm run build:pages && gh-pages -d dist --nojekyll"
  },
  "dependencies": {
    "maplibre-gl": "^5.15.0",
    "pmtiles": "^3.2.0"
  },
  "devDependencies": {
    "gh-pages": "^6.3.0",
    "typescript": "^5.0.0",
    "vite": "^6.0.0"
  }
}
